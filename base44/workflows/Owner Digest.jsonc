{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Hourly owner digest \u2014 scans for unresolved agent errors and surfaces them as owner notifications on the bell.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "owner_digest",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "digest": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "ownerDigest",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Owner digest",
            "description": "Surface unresolved agent errors to the owner"
          }
        }
      }
    ]
  },
  "name": "Owner Digest"
}