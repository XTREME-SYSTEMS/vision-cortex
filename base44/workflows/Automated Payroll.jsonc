{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "automated_payroll",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "process_payroll": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processPayroll",
            "args": {
              "action": "process"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Process payroll",
            "description": "Calculate earnings and log to Google Sheets"
          }
        }
      }
    ]
  },
  "description": "Daily automated payroll \u2014 calculates performance-based earnings from timeclock data and logs to Google Sheets",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Automated Payroll"
}