{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_site_audit",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_audit": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "dailySiteAudit"
          },
          "then": "end",
          "x-base44": {
            "title": "Daily site audit",
            "description": "Crawl the entire site, test every agent, score, and self-reflect"
          }
        }
      }
    ]
  },
  "name": "Daily Site Audit",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 2 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Runs once per day at 2 AM \u2014 crawls the entire site, tests every agent, scores each system, generates self-reflections, and awards bonus points for proactive behavior."
}