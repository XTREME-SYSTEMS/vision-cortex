{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "vision_blueprint_priority",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "prioritize": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "visionBlueprintPrioritizer",
            "args": {
              "action": "prioritize"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Prioritize vision and blueprint",
            "description": "Categorize and dissect the vision/blueprint into a priority task system"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 6 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Vision Blueprint Priority",
  "description": "Runs daily at 6 AM \u2014 dissects the vision and blueprint into a prioritized task system and assigns tasks to agents."
}