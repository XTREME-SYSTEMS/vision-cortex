{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "hours",
      "interval_anchor": "2026-09-05T10:00:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Autonomously researches the next pending knowledge quest every hour using FREE APIs (DuckDuckGo, Wikipedia, Groq/Gemini) \u2014 the obsessive intelligence seeker archetype operating at zero cost",
  "name": "Autonomous Intelligence Gathering",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "autonomous_intelligence_gathering",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "gather": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "freeIntelligenceGatherer",
            "args": {
              "mode": "next_pending"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Gather intelligence (free)",
            "description": "Research next pending quest using free APIs"
          }
        }
      }
    ]
  }
}