{
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Runs the Vision Agent market sweep every morning at 7am ET, logging the top 30 opportunities directly to the Dashboard without a manual trigger.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "morning_vision_sweep",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sweep": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "visionSweep",
            "args": {
              "count": 30
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Vision market sweep",
            "description": "Scan markets and log top 30 opportunities to the Dashboard"
          }
        }
      }
    ]
  },
  "name": "Morning Vision Sweep"
}