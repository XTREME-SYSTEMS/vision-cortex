{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "calendar_auto_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "schedule_deadlines": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "companyOrchestrator",
            "args": {
              "action": "schedule_calendar"
            }
          },
          "then": "schedule_reviews",
          "x-base44": {
            "title": "Schedule deadlines",
            "description": "Create calendar events for task deadlines"
          }
        }
      },
      {
        "schedule_reviews": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "companyOrchestrator",
            "args": {
              "action": "schedule_reviews"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Schedule review sessions",
            "description": "Create review session events for each phase"
          }
        }
      }
    ]
  },
  "description": "Automatically schedules agent deadlines and review sessions in Google Calendar every hour",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Calendar Auto Sync"
}