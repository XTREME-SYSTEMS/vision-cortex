{
  "name": "Auto-Save to Drive",
  "description": "Automatically saves architectural docs and strategy playbooks to Google Drive when a project is approved for the Shadow build queue",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "BuildQueue",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.source == \"shadow_build_strategy\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_save_to_drive",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "save_playbook": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "shadowSaveToDrive",
            "args": {
              "queue_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Save Playbook to Drive",
            "description": "Auto-save strategy docs to Google Drive folder"
          }
        }
      }
    ]
  }
}