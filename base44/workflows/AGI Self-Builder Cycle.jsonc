      "name": "agi_self_builder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "self_build": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "agiSelfBuilder",
            "args": {
              "action": "cycle"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "AGI self-build cycle",
            "description": "Audit blueprint + dispatch next gap"
          }
        }
      }
    ]
  },
  "description": "Autonomously builds Vision Cortex against the AGI Architecture Blueprint \u2014 audits the system, finds the next gap, generates a spec, and dispatches real code/build work to close it. Runs every 6 hours.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 */6 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
