{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "unified_task_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_tasks": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "unifiedTaskSync",
            "args": {
              "action": "sync_all"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sync all tasks to Google Tasks + Calendar",
            "description": "Gather all gaps/fixes/enhancements and sync to Google Tasks and Calendar"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Unified Task Sync",
  "description": "Runs every 15 minutes \u2014 syncs all gaps, fixes, heals, hardens, optimizes, and enhancements to Google Tasks and Google Calendar with validator assignment."
}