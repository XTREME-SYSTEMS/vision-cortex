        "delete",
        "read"
      ]
    },
    {
      "function_name": "bootstrapCoreDocuments",
      "description": "Bootstrap all 16 core documents for the Vision Cortex foundation"
    },
    {
      "function_name": "evolveDocument",
      "description": "Trigger document evolution cascade from a source document, or validate the ecosystem"
    }
  ],
