{
  "name": "IntelFeed",
  "type": "object",
  "properties": {
    "category": {
      "type": "string"
    },
    "headline": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "correlations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "region": {
      "type": "string"
    },
    "impact_score": {
      "type": "number"
    },
    "assigned_agent": {
      "type": "string",
      "description": "Agent responsible for this intel item"
    },
    "source_agent": {
      "type": "string",
      "description": "Agent that scraped/discovered this intel"
    },
    "file_url": {
      "type": "string",
      "description": "URL to attached file if any"
    },
    "drive_organized": {
      "type": "boolean",
      "default": false,
      "description": "Whether this intel has been organized into Google Drive"
    },
    "drive_folder_id": {
      "type": "string",
      "description": "Google Drive folder ID where this intel is stored"
    }
  },
  "required": [
    "category",
    "headline"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}