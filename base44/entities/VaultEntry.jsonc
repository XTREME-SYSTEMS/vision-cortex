{
  "name": "VaultEntry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Friendly label for the account or secret"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "vercel",
        "supabase",
        "railway",
        "groq",
        "google",
        "github",
        "stripe",
        "openai",
        "anthropic",
        "email",
        "domain",
        "hosting",
        "exchange",
        "bank",
        "other"
      ],
      "default": "other"
    },
    "url": {
      "type": "string",
      "description": "Login URL or dashboard link"
    },
    "credentials": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "api_key": {
          "type": "string"
        },
        "api_secret": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "refresh_token": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      },
      "default": {}
    },
    "assigned_api_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "last_synced": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "account_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}