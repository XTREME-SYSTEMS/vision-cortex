{
  "name": "AgentScore",
  "type": "object",
  "properties": {
    "agent_name": {
      "type": "string"
    },
    "test_date": {
      "type": "string",
      "format": "date"
    },
    "score": {
      "type": "number",
      "default": 0
    },
    "max_score": {
      "type": "number",
      "default": 100
    },
    "tests_passed": {
      "type": "number",
      "default": 0
    },
    "tests_total": {
      "type": "number",
      "default": 0
    },
    "success_rate": {
      "type": "number",
      "default": 0
    },
    "failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reflection": {
      "type": "string"
    },
    "capabilities_tested": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "proactive_actions": {
      "type": "number",
      "default": 0
    },
    "tasks_completed": {
      "type": "number",
      "default": 0
    },
    "rank": {
      "type": "number"
    }
  },
  "required": [
    "agent_name",
    "test_date"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}