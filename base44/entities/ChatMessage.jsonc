{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "author": {
      "type": "string"
    },
    "author_type": {
      "type": "string",
      "enum": [
        "user",
        "agent"
      ],
      "default": "agent"
    },
    "content": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "message",
        "insight",
        "warning",
        "opportunity",
        "foresight"
      ],
      "default": "message"
    },
    "accent": {
      "type": "string"
    }
  },
  "required": [
    "author",
    "content"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}