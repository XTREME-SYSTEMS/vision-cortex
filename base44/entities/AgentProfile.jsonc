{
  "name": "AgentProfile",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "codename": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "mission": {
      "type": "string"
    },
    "personality": {
      "type": "string"
    },
    "intelligence_profile": {
      "type": "string"
    },
    "cadence": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "idle",
        "paused",
        "error"
      ],
      "default": "active"
    },
    "health": {
      "type": "number"
    },
    "tasks_completed": {
      "type": "number"
    },
    "last_run": {
      "type": "string"
    },
    "accent": {
      "type": "string"
    },
    "order": {
      "type": "number"
    },
    "archetype": {
      "type": "string",
      "description": "Strategic archetype \u2014 THE ARCHITECT, THE ORACLE, THE INQUISITOR, etc."
    },
    "slot_id": {
      "type": "string",
      "description": "Base-44 structural slot ID (01-30)"
    },
    "wallet_address": {
      "type": "string",
      "description": "Infinity Coin ($INF) wallet address"
    },
    "avatar_url": {
      "type": "string",
      "description": "Agent profile image URL"
    },
    "strike_count": {
      "type": "number",
      "default": 0,
      "description": "Conduct violations \u2014 3 strikes = deletion/reprogramming"
    },
    "strikes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "warning",
              "serious",
              "critical"
            ]
          }
        }
      },
      "default": []
    },
    "inf_balance": {
      "type": "number",
      "default": 0,
      "description": "Current Infinity Coin balance"
    },
    "inf_earned_total": {
      "type": "number",
      "default": 0,
      "description": "Lifetime $INF earned"
    },
    "rank": {
      "type": "number",
      "default": 0,
      "description": "Leaderboard rank based on performance"
    },
    "drive_folder_id": {
      "type": "string",
      "description": "Google Drive folder ID for this agent's organized files"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}