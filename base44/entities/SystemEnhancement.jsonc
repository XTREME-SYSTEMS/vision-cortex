{
  "name": "SystemEnhancement",
  "type": "object",
  "properties": {
    "number": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "existing_system": {
      "type": "string",
      "description": "What exists now \u2014 the current state of the system component being analyzed"
    },
    "downfall": {
      "type": "string",
      "description": "What is wrong, missing, or suboptimal about the existing system"
    },
    "recommended_enhancement": {
      "type": "string",
      "description": "The recommended fix or enhancement"
    },
    "technical_protocols": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Best technical protocols found via web search"
    },
    "surround_enhancements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Related supporting enhancements"
    },
    "web_search_sources": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs found during web search for protocols"
    },
    "approved": {
      "type": "boolean",
      "default": false
    },
    "implementation_code": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "feature",
        "hardening",
        "optimization",
        "healing",
        "doctrine",
        "integration"
      ],
      "default": "feature"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "in_progress",
        "implemented",
        "validating",
        "auditing",
        "audited",
        "failed",
        "blocked",
        "optimized"
      ],
      "default": "pending"
    },
    "priority": {
      "type": "number",
      "default": 3
    },
    "source": {
      "type": "string",
      "default": "autonomous"
    },
    "implementation_plan": {
      "type": "string"
    },
    "implementation_notes": {
      "type": "string"
    },
    "audit_result": {
      "type": "object",
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "score": {
          "type": "number"
        },
        "failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "fix_attempts": {
      "type": "number",
      "default": 0
    },
    "max_fix_attempts": {
      "type": "number",
      "default": 3
    },
    "blocked_reason": {
      "type": "string"
    },
    "last_action_at": {
      "type": "string"
    },
    "build_order_step": {
      "type": "string"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}