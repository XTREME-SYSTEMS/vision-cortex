{
  "name": "LifePlan",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "vision": {
      "type": "string"
    },
    "strategy": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "one_liner": {
          "type": "string"
        },
        "archetype": {
          "type": "string"
        },
        "capital_required_usd": {
          "type": "number"
        },
        "time_to_profit_days": {
          "type": "number"
        }
      }
    },
    "persona_id": {
      "type": "string"
    },
    "idea_id": {
      "type": "string"
    },
    "build_id": {
      "type": "string"
    },
    "horizon": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "label": {
            "type": "string"
          },
          "target_net_worth": {
            "type": "number"
          },
          "target_p10": {
            "type": "number"
          },
          "target_p90": {
            "type": "number"
          },
          "event": {
            "type": "string"
          },
          "decision_id": {
            "type": "string"
          }
        }
      }
    },
    "decision_points": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "prompt": {
            "type": "string"
          },
          "chosen": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rationale": {
            "type": "string"
          }
        }
      }
    },
    "life_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "target_final_net_worth": {
      "type": "number"
    },
    "calendar_synced": {
      "type": "boolean",
      "default": false
    },
    "calendar_event_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reality_log": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "actual_net_worth": {
            "type": "number"
          },
          "expected_net_worth": {
            "type": "number"
          },
          "variance": {
            "type": "number"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "calibration_score": {
      "type": "number"
    },
    "coach_enabled": {
      "type": "boolean",
      "default": true
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "abandoned",
        "off_track"
      ],
      "default": "active"
    }
  },
  "required": [
    "user_id",
    "horizon"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}