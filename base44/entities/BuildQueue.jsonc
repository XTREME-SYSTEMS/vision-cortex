{
  "name": "BuildQueue",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "idea_id": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "queued",
        "strategized",
        "building",
        "launched",
        "failed"
      ],
      "default": "queued"
    },
    "priority": {
      "type": "number",
      "default": 3
    },
    "assigned_agent": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "default": "manual"
    },
    "notes": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "industry": {
      "type": "string"
    },
    "product_type": {
      "type": "string",
      "default": "marketing_site"
    },
    "current_step": {
      "type": "string",
      "default": "profile"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "paused",
        "complete",
        "failed"
      ],
      "default": "queued"
    },
    "auto_advance": {
      "type": "boolean",
      "default": false
    },
    "visited_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}