{
  "name": "Governance",
  "type": "object",
  "properties": {
    "article": {
      "type": "string"
    },
    "principle": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "loyalty",
        "ethics",
        "opsec",
        "charter"
      ],
      "default": "charter"
    },
    "enforcement": {
      "type": "string"
    },
    "rank": {
      "type": "number"
    }
  },
  "required": [
    "article",
    "principle"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}