{
  "name": "SiteAuditLog",
  "type": "object",
  "properties": {
    "site_id": {
      "type": "string",
      "description": "Ref to MonitoredSite.id"
    },
    "site_url": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "audit",
        "fix",
        "heal",
        "optimize",
        "enhance"
      ]
    },
    "score": {
      "type": "number",
      "default": 0
    },
    "summary": {
      "type": "string"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "code_fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "issue": {
            "type": "string"
          },
          "fix": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "complete",
        "failed"
      ],
      "default": "complete"
    }
  },
  "required": [
    "site_id",
    "action"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}