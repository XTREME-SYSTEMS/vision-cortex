{
  "name": "CloneTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Template name"
    },
    "source_url": {
      "type": "string",
      "description": "Original system URL this was cloned from"
    },
    "industry": {
      "type": "string",
      "default": "Uncategorized"
    },
    "description": {
      "type": "string"
    },
    "frontend_spec": {
      "type": "object",
      "description": "Full frontend specification \u2014 pages, components, styles, layout",
      "properties": {
        "pages": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        },
        "styles": {
          "type": "object",
          "default": {}
        },
        "layout": {
          "type": "string"
        },
        "navigation": {
          "type": "object",
          "default": {}
        }
      },
      "default": {}
    },
    "backend_spec": {
      "type": "object",
      "description": "Full backend specification \u2014 entities, functions, APIs, database",
      "properties": {
        "entities": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        },
        "functions": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        },
        "apis": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        },
        "database_schema": {
          "type": "object",
          "default": {}
        },
        "auth_model": {
          "type": "string"
        }
      },
      "default": {}
    },
    "content_map": {
      "type": "object",
      "description": "All extracted content \u2014 text, images, media, metadata",
      "properties": {
        "text_content": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "default": []
        },
        "images": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "media": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "metadata": {
          "type": "object",
          "default": {}
        }
      },
      "default": {}
    },
    "parity_score": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 1
    },
    "visual_parity": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 1
    },
    "operational_parity": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 1
    },
    "content_parity": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "maximum": 1
    },
    "uncloneable_items": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "What the system could not directly clone (inferred/templated instead)"
    },
    "inferred_items": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "What was inferred or templated to achieve full parity"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "validated",
        "approved",
        "archived"
      ],
      "default": "validated"
    },
    "clone_job_id": {
      "type": "string",
      "description": "Source CloneJob ID"
    },
    "rebrand_completed": {
      "type": "boolean",
      "default": false
    },
    "provisioned": {
      "type": "boolean",
      "default": false
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "name",
    "source_url"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}