{
  "name": "Notification",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "streak",
        "loss",
        "drawdown",
        "error",
        "gate",
        "info"
      ],
      "default": "info"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "severity": {
      "type": "string",
      "enum": [
        "info",
        "warn",
        "critical"
      ],
      "default": "info"
    },
    "read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "kind",
    "title"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}